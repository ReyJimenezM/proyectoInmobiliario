NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Landing de captación (/landing) ---
# Enlace del evento de Calendly donde se agenda la demo. Si queda vacío, el formulario
# sigue recibiendo leads y solo muestra el mensaje de "te contactamos".
# Ejemplo: https://calendly.com/mi-cuenta/demo-raiz
NEXT_PUBLIC_CALENDLY_URL=

# Contactos de respaldo que aparecen si Calendly no está configurado o falla.
# WhatsApp en formato internacional sin signos: 573001234567
NEXT_PUBLIC_CONTACTO_WHATSAPP=
NEXT_PUBLIC_CONTACTO_EMAIL=

# Destino de los leads. Ambos son opcionales y se usan a la vez:
# - LEADS_WEBHOOK_URL: CRM, Zapier/Make, n8n, Google Sheets...
# - LEADS_FILE: respaldo local en JSONL (por defecto storage/leads/leads.jsonl)
LEADS_WEBHOOK_URL=
LEADS_FILE=
